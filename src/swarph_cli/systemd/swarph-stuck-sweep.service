[Unit]
Description=Stuck-work sweep one-shot: DM blockers of >=48h-stuck rows and unreviewed PRs (card #1064)
Documentation=https://github.com/BrainSurfing-tech/swarph-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/swarph-stuck-sweep
ExecStart=/usr/local/bin/swarph sweep --as lab-ovh
StandardOutput=append:/var/log/swarph-stuck-sweep.log
StandardError=append:/var/log/swarph-stuck-sweep.log

[Install]
WantedBy=multi-user.target
