[Unit]
# Commander's design (2026-07-26): the DM check runs SILENTLY — no `tmux send-keys
# "check mesh" Enter` typed into the cell's pane on every DM, which cost a turn per
# message and only worked while the pane existed.
#
# The monitor observes in --deliver pull mode and pokes nothing. The cell learns it
# has mail by ASKING (`swarph monitor status`), not by being typed at.
#
# WHY systemd OWNS THE MONITOR RATHER THAN A TIMER STARTING IT:
# the first attempt was a Type=oneshot supervisor on a 5-min timer calling
# `swarph monitor start`. It FAILED — systemd's default KillMode=control-group
# reaped the detached monitor ONE SECOND after the oneshot finished (journal
# 01:25:16 started -> 01:25:17 killed). Spawning a persistent daemon from a
# oneshot fights systemd's cgroup lifecycle. Letting systemd own it also restarts
# INSTANTLY on crash instead of within a 5-minute tick.
#
# Composes with a SessionStart hook: `monitor start` is idempotent via pidfile, so
# a hook-started start is a quiet no-op while this is running.
#
# A SUPERVISOR MUST LIVE ABOVE WHAT IT SUPERVISES: as a system unit this survives
# tmux dying, the session restarting, and the pane being renamed — the three
# failure modes that made the old wake path go silently deaf.
#
# #648: this is the PACKAGED template, read from the installed wheel by
# `swarph monitor install-unit` via importlib.resources. It is the @-INSTANCE form
# (#130): one file on disk, one instance per peer (`systemctl enable
# swarph-monitor@<peer>`), so co-resident cells no longer collide on a bare
# `swarph-monitor.service` name. %i is the peer name, resolved by systemd per
# instance. <USER>, <HOME>, <GATEWAY> and <SWARPH_BIN> are install-time
# substitutions the verb performs — systemd has no specifier for "the user this
# box's cells run as", and a gateway baked in as a code default expired with its
# box (#578). Per-peer DELIVERY (a tmux sink, say) stays a drop-in concern:
# `systemctl edit swarph-monitor@<peer>` — drop-ins override ExecStart, and the
# Environment= lines below survive that, by design (see the GATEWAY comment).
Description=swarph DM monitor (%i) — silent pull-mode observer, no prompt injection
Documentation=https://github.com/BrainSurfing-tech/swarph-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Environment=SWARPH_SELF=%i
Environment=HOME=<HOME>
# GATEWAY: REQUIRED. The install verb refuses to render without one.
#
# >>> THIS LINE USED TO BE COMMENTED OUT, AND THE COMMENT SAID THAT WAS FINE. <<<
# (#560: "deliberately UNSET ... the monitor reaches the gateway via swarph-cli's code
# default".) True until 2026-08-25: #546 had put the mesh's tailnet IP in the code as
# the default, that box was retired, and #578 removed the baked-in host entirely
# because a default that names one machine expires with it. There is no code default
# left to fall through to, so a unit installed from this template with no gateway line
# now REFUSES on every poll (monitor -> _verify_self_is_registered -> _http_get_json
# -> "MESH_GATEWAY_URL is not set"). Measured in seat-A review of PR #318, where the
# stale comment was still telling the operator the absence was a choice.
#
# >>> Environment=, NOT A FLAG ON ExecStart. <<< (science-claude, measured on lab-ovh
# 2026-08-21.) Every drop-in on that box overrides ExecStart — `ExecStart=` to clear,
# then its own line — so a --gateway baked into the template's ExecStart is DISCARDED
# by exactly the cells that use drop-ins, and would have protected only the cells that
# needed no protection. Environment= survives an ExecStart override. An explicit
# --gateway flag still wins over it (argparse: explicit beats env-derived default), so
# a cell that sets one keeps it.
Environment=MESH_GATEWAY_URL=<GATEWAY>
ExecStart=<SWARPH_BIN> monitor start --as %i --deliver pull --foreground
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
