[Unit]
# #654: the oneshot the .path unit fires. Runs `swarph monitor reexec-on-change`,
# which restarts each UNIT-OWNED swarph-monitor@<peer> instance — serially with a
# stagger (R3: eight simultaneous restarts put the whole box's DM path down at
# once), skipping instances with a recorded reexec hold (R4: a deliberate hold is
# a correct engineering decision, not drift), reporting every action to the
# journal (R5), and naming the cells it cannot reach — tmux-scoped monitors are
# OUT OF SCOPE and must be reported, not omitted (R6).
#
# R7: THE RE-EXEC MUST SURVIVE THE INSTALL THAT TRIGGERS IT.
# `pipx install --force` closes site-packages/__init__.py (PathChanged fires)
# BEFORE it restores ~/.local/bin/swarph. Measured 2026-08-30 11:31:27Z on
# lab-ovh: oneshot hit 203/EXEC in that window, Restart=no → one shot, lost,
# silent for two days while the .path unit stayed `active (waiting)`. A touch
# on the watched file never reproduces this: it leaves the shim undisturbed.
# Restart=on-failure retries into the healed state once the shim is back.
# StartLimit* caps a permanent missing binary so PID1 does not loop forever.
#
# LOUD FAILURE (R5 extended): a permanently failed oneshot must reach an
# operator. Do NOT bake a box-local alerter into this template — mercury-alert@
# exists on lab-ovh and not everywhere. Add a drop-in, e.g.
#   OnFailure=mercury-alert@%n.service
# or the box's equivalent, when installing. The Restart= below closes the race;
# the drop-in closes the silence if retries exhaust.
#
# Runs as root: restarting system units owned by the cells' user requires it.
# The oneshot itself executes the NEWLY-INSTALLED code — it starts after the
# install completed, which is exactly the code the fleet is being moved to.
Description=Re-exec supervised swarph monitors after a swarph-cli reinstall (#654)
Documentation=https://github.com/BrainSurfing-tech/swarph-cli
# Cap retries so a permanently missing ExecStart cannot loop forever.
StartLimitIntervalSec=90
StartLimitBurst=12

[Service]
Type=oneshot
# Default oneshot timeout is 90s. Nine stale monitors at the verb's 15s
# stagger is 135s — PID1 kills the job mid-fleet if we inherit it.
TimeoutStartSec=5min
# systemd 230+: Restart=always|on-success are refused for Type=oneshot;
# Restart=on-failure is accepted (verified systemd-analyze verify on 259).
Restart=on-failure
RestartSec=5
ExecStart=<SWARPH_BIN> monitor reexec-on-change --apply --state-root <STATE_ROOT>
