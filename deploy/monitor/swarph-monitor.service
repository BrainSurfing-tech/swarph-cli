[Unit]
# Commander's design (2026-07-26): the DM check runs SILENTLY — no `tmux send-keys
# "check mesh" Enter` typed into the cell's pane on every DM, which cost a turn per
# message and only worked while the pane existed.
#
# The monitor observes in --deliver pull mode and pokes nothing. The cell learns it
# has mail by ASKING (`swarph monitor status`), not by being typed at.
#
# WHY systemd OWNS THE MONITOR RATHER THAN A TIMER STARTING IT:
# the first attempt was a Type=oneshot supervisor on a 5-min timer calling
# `swarph monitor start`. It FAILED — systemd's default KillMode=control-group
# reaped the detached monitor ONE SECOND after the oneshot finished (journal
# 01:25:16 started -> 01:25:17 killed). Spawning a persistent daemon from a
# oneshot fights systemd's cgroup lifecycle. Letting systemd own it also restarts
# INSTANTLY on crash instead of within a 5-minute tick.
#
# Composes with a SessionStart hook: `monitor start` is idempotent via pidfile, so
# a hook-started start is a quiet no-op while this is running.
#
# A SUPERVISOR MUST LIVE ABOVE WHAT IT SUPERVISES: as a system unit this survives
# tmux dying, the session restarting, and the pane being renamed — the three
# failure modes that made the old wake path go silently deaf.
Description=swarph DM monitor (<PEER>) — silent pull-mode observer, no prompt injection
Documentation=https://github.com/BrainSurfing-tech/swarph-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Environment=SWARPH_SELF=<PEER>
Environment=HOME=<HOME>
# GATEWAY: deliberately UNSET, and this comment is the reason (#560).
#
# The monitor reaches the gateway via swarph-cli's code default, which #276 changed
# from `http://localhost:8788` to the mesh's tailnet address. Before that change a
# unit with no gateway line pointed every off-box cell at ITSELF -- present and
# resolvable and wrong, which is the worst shape a default can have.
#
# >>> Environment=, NOT A FLAG ON ExecStart. <<< (science-claude, measured on lab-ovh
# 2026-08-21.) Every drop-in on that box overrides ExecStart -- `ExecStart=` to clear,
# then its own line -- so a --gateway baked into the template's ExecStart is DISCARDED
# by exactly the cells that use drop-ins, and would have protected only the cells that
# needed no protection. Environment= survives an ExecStart override. An explicit
# --gateway flag still wins over it (argparse: explicit beats env-derived default), so
# a cell that sets one keeps it.
#
# OFF-MESH INSTALL: uncomment and set. The code default is a TAILNET address and is
# correct only for cells on this mesh; anywhere else it is a wrong-by-name pointer of
# the same class #276 removed.
# Environment=MESH_GATEWAY_URL=<GATEWAY>
ExecStart=<HOME>/.local/bin/swarph monitor start --as <PEER> --deliver pull --foreground
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
