{
  "description": "gh-identity-router (#397, #1340, #1346). PreToolUse on Bash resolves this cell's gh identity. SessionStart runs gh-route doctor --quiet so an all-resolving box adds one line.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "swarph gh-route doctor --quiet",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "swarph gh-route hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
